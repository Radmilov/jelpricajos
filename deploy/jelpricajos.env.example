# jelpricajos — server settings (/etc/jelpricajos.env)
# Any setting from config.py can be set here. Restart after editing:
#   sudo systemctl restart jelpricajos

HOST=127.0.0.1
PORT=8000
DB_PATH=/var/lib/jelpricajos/speeches.db
LOG_LEVEL=INFO

# 1 vCPU VPS: keep OCR to one thread so the web server stays responsive.
# On 2+ cores, 2 is a good value.
OCR_THREADS=1

# If YouTube says "Sign in to confirm you're not a bot", export cookies from your browser
# (Netscape format), copy them to the server and point to them here:
# YTDLP_COOKIES_FILE=/var/lib/jelpricajos/cookies.txt

# Optional: lets you use /api/simulate remotely with header  X-Admin-Token: <value>
# ADMIN_TOKEN=change-me-to-a-long-random-string
