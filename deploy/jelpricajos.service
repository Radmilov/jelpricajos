[Unit]
Description=jelpricajos (Parlament Srbija OCR + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vucic
Group=vucic
WorkingDirectory=/opt/jelpricajos
EnvironmentFile=/etc/jelpricajos.env
Environment=HOME=/var/lib/jelpricajos
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONWARNINGS=ignore
# Fewer glibc malloc arenas: noticeably lower RSS for PyTorch on small (1 GB) VPSes.
Environment=MALLOC_ARENA_MAX=2
Environment=PATH=/opt/jelpricajos/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/jelpricajos/.venv/bin/python /opt/jelpricajos/app.py
Restart=always
RestartSec=5
# Stop gracefully so an in-progress speech is saved.
KillSignal=SIGINT
TimeoutStopSec=20

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jelpricajos
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
